# Copy to backend/.env for native local development; never commit real secrets.
DATABASE_URL=sqlite:///./carrysafe.db
ENVIRONMENT=local
MCP_URL=http://127.0.0.1:8000/mcp
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173
TIMEZONE=Asia/Kolkata
# Optional: exact provider-supplied OpenAI-compatible base URL and model identifier.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# For Docker Compose: put the following in a ROOT .env, with your own unique values.
POSTGRES_PASSWORD=
DEMO_PASSWORD=
